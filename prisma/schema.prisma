// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  password      String?   // Nullable pour OAuth
  role          String    @default("CLIENT") // CLIENT, ADMIN, AUDITOR, COMMERCIAL, TECHNICIEN
  image         String?
  phone         String?
  
  // Relations
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  accounts      Account[]
  sessions      Session[]
  
  // Audit
  duerpsSigned    DuerpDocument[] @relation("SignedBy")
  auditLogs       AuditLog[]
  auditsAssigned  Audit[]         @relation("AuditsAssigned")
  
  // Relations inverses pour auditeur/commercial
  auditorCompanies    Company[] @relation("AuditorCompanies")
  commercialCompanies Company[] @relation("CommercialCompanies")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([companyId])
  @@map("users")
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// MÉTIERS & ACTIVITÉS (ICPP)
// ============================================

model MetierICPP {
  id          String   @id @default(cuid())
  code        String   @unique // COIFFURE, RESTAURATION, etc.
  nom         String
  description String
  isActive    Boolean  @default(true)
  
  // Relations
  companies       Company[]
  risques         RisqueMetier[]
  unitesTravail   UniteTravail[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("metiers_icpp")
}

// ============================================
// UNITÉS DE TRAVAIL (UT) PAR MÉTIER
// ============================================

model UniteTravail {
  id          String   @id @default(cuid())
  
  // Métier parent
  metierCode  String
  metier      MetierICPP @relation(fields: [metierCode], references: [code], onDelete: Cascade)
  
  // Informations
  nom         String   // "UT1 : Accueil / Vente"
  description String?  // Description optionnelle
  ordre       Int      @default(1) // Ordre d'affichage (1, 2, 3...)
  
  // Relations
  risques     RisqueMetier[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([metierCode])
  @@map("unites_travail")
}

// ============================================
// COMPANY & BUSINESS
// ============================================

model Company {
  id              String   @id @default(cuid())
  name            String
  siret           String?  @unique
  
  // Métier ICPP
  metierCode      String?
  metier          MetierICPP? @relation(fields: [metierCode], references: [code])
  
  employeeCount   Int      @default(1)
  
  // Contact entreprise
  address         String
  postalCode      String?
  city            String
  phone           String?
  email           String?
  
  // Contact principal (responsable)
  contactName     String?
  contactRole     String?
  contactEmail    String?
  
  // Business hours
  openingHours    String?  // JSON string
  
  // Assignation auditeur/commercial
  auditorId       String?
  auditor         User?    @relation("AuditorCompanies", fields: [auditorId], references: [id], onDelete: SetNull)
  
  commercialId    String?
  commercial      User?    @relation("CommercialCompanies", fields: [commercialId], references: [id], onDelete: SetNull)
  
  // Relations
  users           User[]
  duerps          DuerpDocument[]
  subscription    Subscription?
  affichages      Affichage[]
  contrats        Contrat[]
  audits          Audit[]
  signalements    Signalement[]
  salaries        Salarie[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([siret])
  @@index([metierCode])
  @@map("companies")
}

// ============================================
// SALARIÉS
// ============================================

model Salarie {
  id              String   @id @default(cuid())
  
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  nom             String
  prenom          String
  poste           String
  uniteTravail    String
  dateEntree      DateTime
  typeContrat     String   // CDI, CDD, APPRENTISSAGE, STAGE, INTERIM, TEMPS_PARTIEL
  isActive        Boolean  @default(true)
  
  email           String?
  telephone       String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@map("salaries")
}

// ============================================
// RISQUES (Structure Relationnelle ICPP)
// ============================================

model RisqueCategorie {
  id          String   @id @default(cuid())
  code        String   @unique // PHYSIQUE, CHIMIQUE, etc.
  nom         String
  description String?
  ordre       Int      @default(0)
  
  risques     RisqueMetier[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("risques_categories")
}

model RisqueMetier {
  id              String   @id @default(cuid())
  
  // Catégorie
  categorieCode   String
  categorie       RisqueCategorie @relation(fields: [categorieCode], references: [code])
  
  // Métier concerné
  metierCode      String
  metier          MetierICPP @relation(fields: [metierCode], references: [code])
  
  // Unité de Travail (optionnel - pour affectation à une UT spécifique)
  uniteTravailId  String?
  uniteTravail    UniteTravail? @relation(fields: [uniteTravailId], references: [id], onDelete: SetNull)
  
  // Contenu
  nom             String
  description     String
  gravite         String   // FAIBLE, MOYEN, ELEVE
  frequence       Int      @default(1) // 1-5
  
  // Mesures préventives suggérées (JSON array)
  mesuresSuggerees String
  
  isActive        Boolean  @default(true)
  
  // Relations
  evaluations     EvaluationRisque[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categorieCode])
  @@index([metierCode])
  @@index([uniteTravailId])
  @@map("risques_metier")
}

// ============================================
// DUERP & ÉVALUATION
// ============================================

model DuerpDocument {
  id                  String       @id @default(cuid())
  version             Int          @default(1)
  status              String       @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  
  // Company
  companyId           String
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Évaluations de risques
  evaluations         EvaluationRisque[]
  
  // Signature
  signedAt            DateTime?
  signedBy            String?      // User ID
  signer              User?        @relation("SignedBy", fields: [signedBy], references: [id], onDelete: SetNull)
  signatureData       String?      // JSON with IP, timestamp, etc.
  
  // PDF
  pdfUrl              String?
  pdfGeneratedAt      DateTime?
  
  // Metadata
  lastUpdateReason    String?
  nextReviewDate      DateTime?
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("duerp_documents")
}

model EvaluationRisque {
  id                  String   @id @default(cuid())
  
  // DUERP
  duerpId             String
  duerp               DuerpDocument @relation(fields: [duerpId], references: [id], onDelete: Cascade)
  
  // Risque évalué
  risqueId            String
  risque              RisqueMetier @relation(fields: [risqueId], references: [id])
  
  // Unité de travail / Poste concerné
  uniteTravail        String   // Ex: "Cuisine", "Salle"
  
  // Évaluation FxG
  frequence           Int      // 1-5
  gravite             Int      // 1-5
  niveauRisque        Int      // F x G
  
  // Mesures de prévention appliquées
  mesuresAppliquees   String   // JSON array
  
  // Observations
  observations        String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([duerpId])
  @@index([risqueId])
  @@map("evaluations_risques")
}

// ============================================
// PLANS TARIFAIRES & ABONNEMENTS
// ============================================

model PlanTarifaire {
  id              String   @id @default(cuid())
  code            String   @unique // ESSENTIEL, PRO, PREMIUM
  nom             String
  description     String
  prixMensuel     Int      // En centimes
  fraisSetup      Int      @default(0) // Frais de mise en place
  
  // Fonctionnalités (JSON)
  fonctionnalites String
  
  isActive        Boolean  @default(true)
  ordre           Int      @default(0)
  
  subscriptions   Subscription[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("plans_tarifaires")
}

model Subscription {
  id                    String              @id @default(cuid())
  
  // Company
  companyId             String              @unique
  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Plan
  planCode              String
  plan                  PlanTarifaire       @relation(fields: [planCode], references: [code])
  status                String              @default("ACTIVE") // ACTIVE, CANCELED, PAST_DUE, TRIALING, SUSPENDED
  
  // Stripe
  stripeCustomerId      String?             @unique
  stripeSubscriptionId  String?             @unique
  stripePriceId         String?
  
  // Billing
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean             @default(false)
  canceledAt            DateTime?
  
  // Trial & Promo
  trialStart            DateTime?
  trialEnd              DateTime?
  promoCode             String?
  
  // Frais de setup payé
  setupFeePaid          Boolean             @default(false)
  setupFeePaidAt        DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([planCode])
  @@map("subscriptions")
}

// ============================================
// CONTRATS & CGV
// ============================================

model CGVVersion {
  id              String   @id @default(cuid())
  version         String   @unique // "1.0", "1.1", etc.
  contenu         String   // Texte complet ou URL
  datePublication DateTime
  isActive        Boolean  @default(true)
  
  acceptations    CGVAcceptation[]
  contrats        Contrat[]
  
  createdAt       DateTime @default(now())

  @@map("cgv_versions")
}

model CGVAcceptation {
  id              String   @id @default(cuid())
  
  // User
  userId          String
  
  // CGV
  cgvVersion      String
  cgv             CGVVersion @relation(fields: [cgvVersion], references: [version])
  
  // Preuve
  acceptedAt      DateTime @default(now())
  ipAddress       String
  userAgent       String?
  
  @@index([userId])
  @@index([cgvVersion])
  @@map("cgv_acceptations")
}

model Contrat {
  id                String   @id @default(cuid())
  numeroContrat     String   @unique
  
  // Company
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // CGV
  cgvVersion        String
  cgv               CGVVersion @relation(fields: [cgvVersion], references: [version])
  
  // Dates
  dateDebut         DateTime
  dateFin           DateTime?
  
  // Signature
  signedAt          DateTime?
  signatureData     String?  // JSON with IP, timestamp
  
  // PDF
  pdfUrl            String?
  pdfGeneratedAt    DateTime?
  
  status            String   @default("ACTIF") // ACTIF, RESILIE, SUSPENDU
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("contrats")
}

// ============================================
// AFFICHAGES OBLIGATOIRES
// ============================================

model Affichage {
  id          String        @id @default(cuid())
  type        String        // INSPECTION_TRAVAIL, MEDECINE_TRAVAIL, etc.
  category    String        @default("FICHE_1") // FICHE_1, FICHE_2, FICHE_3, FICHE_4
  title       String
  description String?       
  
  // Company
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Données dynamiques (Fiche 1 : coordonnées inspection, médecine, référent, horaires, CSE)
  dynamicData String?       // JSON
  
  // File
  fileUrl     String?
  
  // Versioning (Fiche 2 : textes juridiques versionnés par ICPP)
  version     Int           @default(1)
  isLocked    Boolean       @default(false) // true pour les fiches juridiques non modifiables
  
  // Status
  downloaded  Boolean       @default(false)
  printed     Boolean       @default(false)
  generatedAt DateTime?     // Date de dernière génération PDF
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId])
  @@index([category])
  @@map("affichages")
}

// ============================================
// NOTIFICATIONS & REMINDERS
// ============================================

model Notification {
  id        String            @id @default(cuid())
  type      String            // DUERP_ANNUAL_REMINDER, etc.
  title     String
  message   String            
  
  // Target
  userId    String?
  
  // Status
  read      Boolean           @default(false)
  readAt    DateTime?
  
  // Action
  actionUrl String?
  
  createdAt DateTime          @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String      @id @default(cuid())
  action      String      // USER_LOGIN, DUERP_CREATED, etc.
  description String?     
  
  // User
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Metadata
  metadata    String?     // JSON
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// AUDITS TERRAIN (Planification)
// ============================================

model Audit {
  id            String    @id @default(cuid())
  
  // Company
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Auditor assigned
  auditorId     String?
  auditor       User?     @relation("AuditsAssigned", fields: [auditorId], references: [id], onDelete: SetNull)
  
  // Type & Status
  type          String    @default("INITIAL") // INITIAL, ANNUEL, INCIDENT
  status        String    @default("PLANIFIE") // PLANIFIE, EN_COURS, TERMINE, ANNULE
  
  // Dates
  dateAudit     DateTime
  dateRealisation DateTime?
  
  // Observations
  observations  String?
  rapport       String?   // PDF URL
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@index([auditorId])
  @@index([status])
  @@map("audits")
}

// ============================================
// SIGNALEMENTS
// ============================================

model Signalement {
  id          String    @id @default(cuid())
  
  // Reporter
  userId      String?
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  // Content
  type        String    // INCIDENT, DANGER, AMELIORATION
  titre       String
  description String
  
  // Status
  status      String    @default("NOUVEAU") // NOUVEAU, EN_COURS, TRAITE, REJETE
  
  // Response
  reponse     String?
  traiteParId String?
  traiteAt    DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([companyId])
  @@map("signalements")
}

// ============================================
// RÉGLEMENTATIONS PAR MÉTIER
// ============================================

model Reglementation {
  id          String    @id @default(cuid())
  
  // Métier concerné (optionnel - null = applicable à tous)
  metierCode  String?
  
  // Métiers concernés (JSON array des codes métiers)
  metiersCodes String   @default("[]")
  
  // Content
  titre       String
  description String?
  contenu     String?   // Rich text ou markdown
  
  // Type de réglementation
  type        String    @default("GENERALE") // GENERALE, HYGIENE, SECURITE, ENVIRONNEMENT
  
  // Categorization (garde pour rétrocompatibilité)
  categorie   String    @default("GENERAL") // GENERAL, HYGIENE, SECURITE, ENVIRONNEMENT
  
  // Status
  isActive    Boolean   @default(true)
  impactDuerp Boolean   @default(false)
  ordre       Int       @default(0)
  
  // Dates
  dateVigueur     DateTime  @default(now())  // Date d'entrée en vigueur
  dateMaj         DateTime  @default(now())  // Date de mise à jour
  dateApplication DateTime?
  dateExpiration  DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([metierCode])
  @@index([isActive])
  @@map("reglementations")
}

// ============================================
// APP SETTINGS (Paramètres Globaux)
// ============================================

model AppSettings {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("app_settings")
}
